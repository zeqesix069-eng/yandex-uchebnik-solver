<Window x:Class="YandexSolver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EduTools · by zxchomezxc"
        Width="780"
        Height="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Border Margin="10"
            Background="{DynamicResource BgRootBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource WindowRadius}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.4" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource BgChromeBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="{DynamicResource HeaderRadius}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="EduTools · by zxchomezxc"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontFamily="Segoe UI"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,18,0" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="WorkTabRadio"
                                     Content="Яндекс Учебник"
                                     Style="{StaticResource NavTabStyle}"
                                     IsChecked="True"
                                     Checked="NavTab_Changed"
                                     Margin="0,0,4,0" />
                        <RadioButton x:Name="DatalessonTabRadio"
                                     Content="Урок Цифры"
                                     Style="{StaticResource NavTabStyle}"
                                     Checked="NavTab_Changed"
                                     Margin="0,0,4,0" />
                        <RadioButton x:Name="InformaticsTabRadio"
                                     Content="Информатика"
                                     Style="{StaticResource NavTabStyle}"
                                     Checked="NavTab_Changed"
                                     Margin="0,0,4,0" />
                        <RadioButton x:Name="SettingsTabRadio"
                                     Content="Настройки"
                                     Style="{StaticResource NavTabStyle}"
                                     Checked="NavTab_Changed" />
                    </StackPanel>

                    <Border Grid.Column="3"
                            Background="{DynamicResource BgSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlRadius}"
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="#71717A" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="ConnectionPillText"
                                       Text="CDP: не подключён"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11.5"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="—" Style="{StaticResource WindowButtonStyle}" Click="Minimize_Click" Margin="0,0,2,0" />
                        <Button Content="✕" Style="{StaticResource WindowButtonStyle}" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="WorkPanel" Grid.Row="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="130" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource BgSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource CardRadius}"
                        Padding="12"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Браузер (Chrome / Edge CDP)"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="BrowserStatusLabel"
                                       Text="Откройте браузер, войдите в учебник и подключитесь"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="12"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Chrome"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="LaunchChrome_Click"
                                Margin="8,0,6,0" />

                        <Button Grid.Column="2"
                                Content="Edge"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="LaunchEdge_Click"
                                Margin="0,0,6,0" />

                        <Button Grid.Column="3"
                                x:Name="ConnectButton"
                                Content="Подключить"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ConnectCdp_Click"
                                Margin="0,0,6,0" />

                        <Button Grid.Column="4"
                                Content="Автовход"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="AutoLogin_Click"
                                Margin="0,0,6,0" />

                        <Button Grid.Column="5"
                                Content="Обновить"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="RefreshTask_Click" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            x:Name="SolveStepButton"
                            Content="Решить текущий шаг"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="SolveStep_Click" />

                    <Button Grid.Column="2"
                            x:Name="AutoRunButton"
                            Content="Автопрохождение"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="AutoRun_Click" />

                    <Button Grid.Column="4"
                            x:Name="StopButton"
                            Content="Стоп"
                            Style="{StaticResource DangerButtonStyle}"
                            IsEnabled="False"
                            Click="Stop_Click" />

                    <Border Grid.Column="6"
                            Background="{DynamicResource BgSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlRadius}"
                            Padding="10,0">
                        <TextBlock x:Name="SolvedCounterText"
                                   Text="Шагов: 0"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <Border Grid.Row="2"
                        Background="{DynamicResource BgSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource CardRadius}"
                        Padding="10"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="Текущее задание"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <TextBox x:Name="TaskPreviewBox"
                                 Grid.Row="1"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="{DynamicResource BgLogBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1"
                                 FontSize="12"
                                 Padding="8"
                                 Text="Нажмите «Обновить» после подключения к вкладке задания." />
                    </Grid>
                </Border>

                <Border Grid.Row="3"
                        Background="{DynamicResource BgSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource CardRadius}"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="Журнал"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button Content="Очистить"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="8,3"
                                    FontSize="11"
                                    Click="ClearLog_Click" />
                        </Grid>
                        <TextBox x:Name="LogBox"
                                 Grid.Row="1"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="{DynamicResource BgLogBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1"
                                 FontFamily="Consolas"
                                 FontSize="11.5"
                                 Padding="8" />
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="DatalessonPanel" Grid.Row="1" Margin="16" Visibility="Collapsed">
                <StackPanel>
                    <Border Background="{DynamicResource BgSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource CardRadius}"
                            Padding="16"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Получение сертификата «Урок Цифры»"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Вставьте ссылку на тренажёр или страницу урока с параметром session_id"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="12"
                                       Margin="0,0,0,14" />

                            <TextBlock Text="Ссылка на урок"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11.5"
                                       Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DlUrlBox"
                                         Grid.Column="0"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         KeyDown="DlUrlBox_KeyDown"
                                         Margin="0,0,8,0" />
                                <Button Grid.Column="1"
                                        Content="Вставить"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="DlPaste_Click" />
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Код урока (необязательно):"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0" />
                                <TextBox x:Name="DlSlugBox"
                                         Grid.Column="1"
                                         Style="{StaticResource InputTextBoxStyle}" />
                            </Grid>

                            <Button x:Name="DlResolveButton"
                                    Content="Получить сертификат"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Padding="18,9"
                                    Click="DlResolve_Click" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource BgSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource CardRadius}"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="Ссылка на сертификат"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11.5"
                                       Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DlResultBox"
                                         Grid.Column="0"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         IsReadOnly="True"
                                         Margin="0,0,8,0" />
                                <Button x:Name="DlCopyButton"
                                        Grid.Column="1"
                                        Content="Копировать"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        IsEnabled="False"
                                        Click="DlCopy_Click"
                                        Margin="0,0,6,0" />
                                <Button x:Name="DlOpenButton"
                                        Grid.Column="2"
                                        Content="Открыть"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        IsEnabled="False"
                                        Click="DlOpen_Click" />
                            </Grid>
                            <TextBlock x:Name="DlStatusText"
                                       Text="Ожидание ссылки..."
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="InformaticsPanel"
                          Grid.Row="1"
                          Margin="16"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel>
                    <Border Background="{DynamicResource BgSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource CardRadius}"
                            Padding="14"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Системы счисления (2 ↔ 8 ↔ 10 ↔ 16)"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="BaseInputBox" Grid.Column="0" Style="{StaticResource InputTextBoxStyle}" Text="255" />
                                <ComboBox x:Name="BaseFromCombo" Grid.Column="2" Style="{StaticResource DarkComboBoxStyle}">
                                    <ComboBoxItem Content="10 (DEC)" IsSelected="True" />
                                    <ComboBoxItem Content="2 (BIN)" />
                                    <ComboBoxItem Content="8 (OCT)" />
                                    <ComboBoxItem Content="16 (HEX)" />
                                </ComboBox>
                                <Button Grid.Column="4" Content="Перевести" Style="{StaticResource PrimaryButtonStyle}" Click="ConvertBase_Click" />
                            </Grid>
                            <TextBox x:Name="BaseOutputBox"
                                     IsReadOnly="True"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Background="{DynamicResource BgLogBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"
                                     Padding="8"
                                     Height="74" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource BgSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource CardRadius}"
                            Padding="14"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Объём информации (текст / изображение)"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Символов / Ширина" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,3" />
                                    <TextBox x:Name="InfoArg1Box" Style="{StaticResource InputTextBoxStyle}" Text="1024" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Бит/симв. / Высота" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,3" />
                                    <TextBox x:Name="InfoArg2Box" Style="{StaticResource InputTextBoxStyle}" Text="16" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Глубина цвета (0=текст)" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,3" />
                                    <TextBox x:Name="InfoArg3Box" Style="{StaticResource InputTextBoxStyle}" Text="0" />
                                </StackPanel>
                                <Button Grid.Column="6" VerticalAlignment="Bottom" Content="Посчитать" Style="{StaticResource SecondaryButtonStyle}" Click="CalcInfoSize_Click" />
                            </Grid>
                            <TextBox x:Name="InfoOutputBox" Style="{StaticResource InputTextBoxStyle}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource BgSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource CardRadius}"
                            Padding="14">
                        <StackPanel>
                            <TextBlock Text="Таблица истинности (and, or, not, xor, ->, ==)"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TruthExprBox" Grid.Column="0" Style="{StaticResource InputTextBoxStyle}" Text="(A or B) and not C" />
                                <Button Grid.Column="2" Content="Построить" Style="{StaticResource PrimaryButtonStyle}" Click="BuildTruthTable_Click" />
                            </Grid>
                            <TextBox x:Name="TruthOutputBox"
                                     IsReadOnly="True"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Background="{DynamicResource BgLogBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"
                                     Padding="8"
                                     Height="120" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SettingsPanel"
                          Grid.Row="1"
                          Margin="16"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel>
                    <Border Background="{DynamicResource BgSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource CardRadius}"
                            Padding="14"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Оформление"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Тема" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4" />
                                    <ComboBox x:Name="ThemeCombo"
                                              Style="{StaticResource DarkComboBoxStyle}"
                                              SelectionChanged="Appearance_Changed">
                                        <ComboBoxItem Content="Dark (Slate)" />
                                        <ComboBoxItem Content="Light" />
                                        <ComboBoxItem Content="Midnight" />
                                        <ComboBoxItem Content="OLED Black" />
                                        <ComboBoxItem Content="Nord" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Акцент" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4" />
                                    <ComboBox x:Name="AccentCombo"
                                              Style="{StaticResource DarkComboBoxStyle}"
                                              SelectionChanged="Appearance_Changed">
                                        <ComboBoxItem Content="Синий" />
                                        <ComboBoxItem Content="Изумрудный" />
                                        <ComboBoxItem Content="Янтарный" />
                                        <ComboBoxItem Content="Красный" />
                                        <ComboBoxItem Content="Серый" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Скругление" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4" />
                                    <ComboBox x:Name="CornerCombo"
                                              Style="{StaticResource DarkComboBoxStyle}"
                                              SelectionChanged="Appearance_Changed">
                                        <ComboBoxItem Content="Острые" />
                                        <ComboBoxItem Content="Стандарт" />
                                        <ComboBoxItem Content="Мягкие" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Прозрачность" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" />
                                        <TextBlock x:Name="OpacityValueText"
                                                   Text="100%"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="11.5"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <Slider x:Name="OpacitySlider"
                                            Minimum="0.80"
                                            Maximum="1.00"
                                            TickFrequency="0.02"
                                            IsSnapToTickEnabled="True"
                                            Value="1.00"
                                            Margin="0,6,0,0"
                                            ValueChanged="OpacitySlider_ValueChanged" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource BgSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource CardRadius}"
                            Padding="14"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="ИИ и API"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Провайдер" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4" />
                                    <ComboBox x:Name="ProviderCombo"
                                              Style="{StaticResource DarkComboBoxStyle}"
                                              SelectionChanged="ProviderCombo_SelectionChanged">
                                        <ComboBoxItem Content="OpenRouter" />
                                        <ComboBoxItem Content="Pollinations.ai" />
                                        <ComboBoxItem Content="Google Gemini" />
                                        <ComboBoxItem Content="Groq" />
                                        <ComboBoxItem Content="OpenAI" />
                                        <ComboBoxItem Content="WusRouter" />
                                        <ComboBoxItem Content="Ollama (локально)" />
                                        <ComboBoxItem Content="Custom" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Модель" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4" />
                                    <TextBox x:Name="ModelBox" Style="{StaticResource InputTextBoxStyle}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="API-ключ" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="ApiKeyPasswordBox" Style="{StaticResource InputPasswordBoxStyle}" />
                                        <TextBox x:Name="ApiKeyPlainBox" Style="{StaticResource InputTextBoxStyle}" Visibility="Collapsed" />
                                        <Button Grid.Column="1"
                                                Content="Показать"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="10,6"
                                                Margin="6,0,0,0"
                                                Click="ToggleKeyVisibility_Click" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Base URL" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4" />
                                    <TextBox x:Name="BaseUrlBox" Style="{StaticResource InputTextBoxStyle}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Temperature" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" />
                                        <TextBlock x:Name="TempValueText"
                                                   Text="0.10"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="11.5"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <Slider x:Name="TempSlider"
                                            Minimum="0"
                                            Maximum="1"
                                            TickFrequency="0.05"
                                            IsSnapToTickEnabled="True"
                                            Value="0.1"
                                            ValueChanged="TempSlider_ValueChanged" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Доп. системный промпт (необязательно)" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4" />
                                    <TextBox x:Name="SystemPromptBox" Style="{StaticResource InputTextBoxStyle}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="TestApiButton"
                                        Content="Проверить API"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="TestApi_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource BgSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource CardRadius}"
                            Padding="14"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Поведение и тайминги"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Порт CDP" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4" />
                                    <TextBox x:Name="CdpPortBox" Style="{StaticResource InputTextBoxStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Пауза ответа (мс)" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4" />
                                    <TextBox x:Name="SubmitDelayBox" Style="{StaticResource InputTextBoxStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Пауза шага (мс)" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4" />
                                    <TextBox x:Name="StepDelayBox" Style="{StaticResource InputTextBoxStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Макс. шагов" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4" />
                                    <TextBox x:Name="MaxStepsBox" Style="{StaticResource InputTextBoxStyle}" />
                                </StackPanel>
                            </Grid>

                            <WrapPanel Margin="0,2,0,8">
                                <CheckBox x:Name="AutoAdvanceCheck"
                                          Content="Автопереход на «Дальше»"
                                          Style="{StaticResource DarkCheckBoxStyle}"
                                          Margin="0,0,18,6" />
                                <CheckBox x:Name="SkipTheoryCheck"
                                          Content="Пропускать теорию"
                                          Style="{StaticResource DarkCheckBoxStyle}"
                                          Margin="0,0,18,6" />
                                <CheckBox x:Name="RetryOnWrongCheck"
                                          Content="Повтор при ошибке"
                                          Style="{StaticResource DarkCheckBoxStyle}"
                                          Margin="0,0,18,6" />
                                <CheckBox x:Name="PortableModeCheck"
                                          Content="Portable (рядом с exe)"
                                          Style="{StaticResource DarkCheckBoxStyle}"
                                          Margin="0,0,18,6" />
                                <CheckBox x:Name="BossHotkeyCheck"
                                          Content="Скрытие (Ctrl+Shift+H)"
                                          Style="{StaticResource DarkCheckBoxStyle}"
                                          Margin="0,0,0,6" />
                            </WrapPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Код школы (для автовхода)" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4" />
                                    <TextBox x:Name="SchoolCodeBox" Style="{StaticResource InputTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Логин ученика" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4" />
                                    <TextBox x:Name="StudentLoginBox" Style="{StaticResource InputTextBoxStyle}" />
                                </StackPanel>
                                <Button Grid.Column="4"
                                        VerticalAlignment="Bottom"
                                        Content="Очистить следы"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Click="CleanTraces_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Сбросить"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ResetSettings_Click"
                                Margin="0,0,8,0" />
                        <Button Content="Сохранить настройки"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="SaveSettings_Click" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{DynamicResource BgChromeBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="{DynamicResource FooterRadius}"
                    Padding="14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#71717A" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusText"
                               Grid.Column="1"
                               Text="Готово."
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11.5"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="by zxchomezxc"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11.5"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
